# .env.example  (copy to .env, never commit .env)
# Free key from https://web3forms.com, sends the enquiry form to her email
PUBLIC_WEB3FORMS_KEY=
# Free key from https://www.pexels.com/api, used only by `npm run photos`
PEXELS_API_KEY=
# Optional privacy friendly analytics (plausible.io). Your site domain, no https://
PUBLIC_PLAUSIBLE_DOMAIN=
