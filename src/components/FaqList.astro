---
// src/components/FaqList.astro
interface Props { items: { q: string; a: string }[]; }
const { items } = Astro.props;
---
<div class="faq">
  {items.map((f) => (
    <details>
      <summary><span>{f.q}</span><i aria-hidden="true"></i></summary>
      <div class="faq-a"><p>{f.a}</p></div>
    </details>
  ))}
</div>
