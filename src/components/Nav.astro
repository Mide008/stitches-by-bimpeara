---
// src/components/Nav.astro  (minimal: wordmark, theme, menu)
import { categories, site, waLink } from '../data/site';
import CurrencySelect from './CurrencySelect.astro';
import Logo from './Logo.astro';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const extra = [{ href: '/about', label: 'About' }, { href: '/lookbook', label: 'Lookbook' }, { href: '/contact', label: 'Contact' }];
---
<header class="nav" data-nav>
  <div class="nav-in container">
    <a href="/" class="brand" aria-label={`${site.name}, home`}>
      <Logo variant="mark" class="brand-mark" label="" />
      <span class="brand-text"><span class="brand-small">Stitches by</span><span class="brand-main">Bimpeara</span></span>
    </a>
    <div class="nav-actions">
      <button class="theme" data-theme-toggle aria-label="Switch theme" type="button"><span class="swatch"></span></button>
      <button class="menu-btn" data-menu-btn aria-expanded="false" aria-controls="menu" type="button">
        <span class="mb-label" data-menu-label>Menu</span><span class="mb-ico" aria-hidden="true"><i></i><i></i></span>
      </button>
    </div>
  </div>

  <div class="menu" id="menu" data-menu aria-hidden="true" data-lenis-prevent>
    <p class="menu-h">The collections</p>
    <nav class="menu-links" aria-label="Collections">
      {categories.map((c, i) => (
        <a href={`/${c.slug}`} class="menu-link" aria-current={path === `/${c.slug}` ? 'page' : undefined}><span class="n">0{i + 1}</span><span>{c.label}</span></a>
      ))}
    </nav>
    <nav class="menu-sub" aria-label="More">
      {extra.map((l) => <a href={l.href} class="link" aria-current={path === l.href ? 'page' : undefined}>{l.label}</a>)}
    </nav>
    <CurrencySelect class="menu-cur" />
    <button class="btn btn-primary menu-cta" type="button" data-open-enquiry>Book a fitting</button>
    <div class="menu-foot">
      <a class="link" href={waLink()} target="_blank" rel="noopener noreferrer">WhatsApp</a>
      <a class="link" href={site.instagram} target="_blank" rel="noopener noreferrer">Instagram</a>
      <a class="link" href={`mailto:${site.email}`}>Email</a>
    </div>
  </div>
</header>

<style is:global>
  .nav { position: fixed; inset: 0 0 auto 0; z-index: 70; height: var(--nav-h); transition: transform .6s var(--ease), background-color .5s, backdrop-filter .5s; }
  .nav.scrolled { background: color-mix(in srgb, var(--bg) 82%, transparent); backdrop-filter: blur(16px) saturate(1.2); border-bottom: 1px solid var(--line); }
  .nav.hide { transform: translateY(-101%); }
  .nav-in { height: 100%; display: flex; align-items: center; justify-content: space-between; }
  .brand { display: flex; align-items: center; gap: .7rem; line-height: 1; }
  .brand-mark { height: 52px; flex: none; }
  .brand-text { display: grid; line-height: 1; }
  .brand-small { font-family: var(--font-script); font-size: 1.3rem; color: var(--accent); transform: rotate(-4deg); transform-origin: left; margin-bottom: -.2rem; transition: transform .5s var(--ease); }
  .brand-main { font-family: var(--font-display); font-size: 1.9rem; font-weight: 600; letter-spacing: -.01em; }
  .nav-actions { display: flex; align-items: center; gap: .7rem; }
  .theme { width: 44px; height: 44px; display: grid; place-items: center; border-radius: 50%; border: 1px solid var(--line); background: color-mix(in srgb, var(--surface) 70%, transparent); transition: border-color .3s, transform .5s var(--ease); }
  .swatch { width: 18px; height: 18px; border-radius: 50%; background: conic-gradient(from 90deg, #0f1524 0 50%, #f5f1e9 50% 100%); box-shadow: 0 0 0 1px var(--line); }
  .menu-btn { display: inline-flex; align-items: center; gap: .7rem; height: 44px; padding: 0 1.2rem; border-radius: 999px; border: 1px solid var(--line); background: color-mix(in srgb, var(--surface) 80%, transparent); font-size: .82rem; font-weight: 500; letter-spacing: .16em; text-transform: uppercase; transition: border-color .3s, background .3s; }
  .mb-ico { display: grid; gap: 5px; } .mb-ico i { display: block; width: 16px; height: 1.5px; background: var(--ink); transition: transform .5s var(--ease); }
  .menu-btn[aria-expanded='true'] .mb-ico i:first-child { transform: translateY(3.25px) rotate(45deg); } .menu-btn[aria-expanded='true'] .mb-ico i:last-child { transform: translateY(-3.25px) rotate(-45deg); }

  .menu { position: absolute; top: calc(var(--nav-h) - 6px); right: var(--pad); width: min(360px, calc(100vw - 2 * var(--pad))); padding: 1.6rem 1.6rem 1.3rem; display: grid; gap: 1.1rem;
    background: var(--surface); color: var(--ink); border: 1px solid var(--line); border-radius: 22px; box-shadow: 0 30px 70px rgba(0, 0, 0, .22);
    transform-origin: top right; opacity: 0; visibility: hidden; transform: translateY(-10px) scale(.96); transition: opacity .35s var(--ease), transform .55s var(--ease), visibility 0s .55s; max-height: calc(100svh - var(--nav-h) - 1rem); overflow-y: auto; }
  .menu.open { opacity: 1; visibility: visible; transform: none; transition: opacity .35s var(--ease), transform .55s var(--ease); }
  .menu-h { font: 600 .72rem/1 var(--font-body); letter-spacing: .22em; text-transform: uppercase; color: var(--muted); }
  .menu-links { display: grid; }
  .menu-link { display: flex; align-items: baseline; gap: 1rem; padding: .7rem 0; border-bottom: 1px solid var(--line); font-family: var(--font-display); font-size: 1.9rem; line-height: 1.05; font-weight: 400; transition: color .3s; opacity: 0; transform: translateY(8px); }
  .menu.open .menu-link { opacity: 1; transform: none; transition: color .3s, opacity .5s var(--ease), transform .6s var(--ease); }
  .menu.open .menu-link:nth-child(2) { transition-delay: 0s, .05s, .05s; } .menu.open .menu-link:nth-child(3) { transition-delay: 0s, .1s, .1s; } .menu.open .menu-link:nth-child(4) { transition-delay: 0s, .15s, .15s; }
  .menu-link .n { font: 500 .72rem/1 var(--font-body); letter-spacing: .16em; color: var(--accent); }
  .menu-link span:last-child { transition: transform .5s var(--ease); }
  @media (hover: hover) { .menu-link:hover { color: var(--accent); } .menu-link:hover span:last-child { transform: translateX(.6rem); } .brand:hover .brand-small { transform: rotate(-8deg) translateX(4px); } .theme:hover { border-color: var(--ink); transform: rotate(40deg); } .menu-btn:hover { border-color: var(--ink); } }
  .menu-btn:active, .theme:active { transform: scale(.96); }
  @media (prefers-reduced-motion: reduce) { * { transition-duration: .001ms !important; } }
  .menu-sub { display: flex; gap: 1.4rem; font-size: .95rem; } .menu-cta { justify-content: center; }
  .menu-foot { display: flex; justify-content: space-between; font-size: .85rem; color: var(--muted); border-top: 1px solid var(--line); padding-top: .9rem; }
</style>
