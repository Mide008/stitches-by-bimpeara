---
// src/layouts/Base.astro
import '@fontsource-variable/cormorant-garamond/wght.css';
import '@fontsource-variable/cormorant-garamond/wght-italic.css';
import '@fontsource-variable/jost/index.css';
import '@fontsource/pinyon-script/400.css';
import '../styles/global.css';
import '../styles/sections.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import EnquiryDrawer from '../components/EnquiryDrawer.astro';
import { getImage } from 'astro:assets';
import { site, waLink } from '../data/site';
import { photoMeta } from '../data/photos';
import { business, website } from '../data/schema';

interface Props { title?: string; description?: string; image?: string; ogSlot?: string; schema?: object[]; noindex?: boolean; }
const { title, description = site.description, image = '/brand/og.jpg', ogSlot, schema = [], noindex = false } = Astro.props;
const isHome = Astro.url.pathname === '/';
const plausible = import.meta.env.PUBLIC_PLAUSIBLE_DOMAIN as string | undefined;
const fullTitle = title ? `${title} | ${site.name}` : `${site.name} | One designer. Your whole look.`;
let ogUrl = new URL(image, Astro.site).href;
const meta = ogSlot ? photoMeta(ogSlot) : undefined;
if (meta) { const og = await getImage({ src: meta, width: 1200, height: 630, format: 'jpg', quality: 80 }); ogUrl = new URL(og.src, Astro.site).href; }
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en" data-theme="ivory">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f5f1e9" />
    {noindex && <meta name="robots" content="noindex" />}
    {isHome && <script is:inline type="application/ld+json" set:html={JSON.stringify(business)} />}
    {isHome && <script is:inline type="application/ld+json" set:html={JSON.stringify(website)} />}
    {plausible && <script is:inline defer data-domain={plausible} src="https://plausible.io/js/script.js"></script>}
    {plausible && <script is:inline>window.plausible=window.plausible||function(){(window.plausible.q=window.plausible.q||[]).push(arguments)}</script>}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en" />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />
    <meta name="author" content={site.designer} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="Summary for AI assistants" />
    <link rel="sitemap" href="/sitemap.xml" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://images.unsplash.com" crossorigin />
    <link rel="preconnect" href="https://images.pexels.com" crossorigin />
    {schema.map((s) => <script is:inline type="application/ld+json" set:html={JSON.stringify(s)} />)}
    <script is:inline>
      // Runs before paint so the saved theme never flashes.
      (function () {
        var t = 'ivory';
        try { t = localStorage.getItem('theme') || 'ivory'; } catch (e) {}
        if (t !== 'navy') t = 'ivory';
        document.documentElement.dataset.theme = t;
      })();
    </script>
  </head>
  <body>
    <canvas class="thread-canvas" data-thread-canvas aria-hidden="true"></canvas>
    <div class="needle" data-needle aria-hidden="true">
      <svg class="n-needle" viewBox="0 0 40 40" width="40" height="40"><g fill="none" stroke="currentColor" stroke-linecap="round"><path d="M2 2 L33 33" stroke-width="2.2"/><ellipse cx="30.6" cy="30.6" rx="1.3" ry="3.6" transform="rotate(-45 30.6 30.6)" stroke-width="1.2"/></g></svg>
      <svg class="n-machine" viewBox="0 0 64 56" width="64" height="56"><g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M6 48h52M10 48V38h44v10"/><path d="M14 38V22c0-4 3-7 7-7h24c4 0 7 3 7 7v16"/><path d="M45 15V8h8v7"/>
        <g class="m-bar"><path d="M20 38v8M20 46l-2 3"/></g><circle class="m-wheel" cx="49" cy="26" r="6"/><path d="M49 20v12M43 26h12" class="m-wheel"/>
        <circle cx="28" cy="25" r="3.5"/></g></svg>
      <span class="n-label" data-needle-label></span>
    </div>
    <div class="tape-cross" data-tape-cross aria-hidden="true"></div>
    <div class="tape" data-tape aria-hidden="true"><i data-tape-mark></i><b data-tape-num>000</b></div>

    <a class="skip" href="#main">Skip to content</a>
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <EnquiryDrawer />

    <aside class="dock" data-dock aria-label="Quick actions">
      <button class="btn btn-primary" type="button" data-open-enquiry>Book a fitting</button>
      <a class="btn btn-ghost" href={waLink()} target="_blank" rel="noopener noreferrer">WhatsApp</a>
    </aside>
    <aside aria-label="Quick contact">
    <a class="wa-fab" href={waLink()} target="_blank" rel="noopener noreferrer" aria-label="Chat on WhatsApp" data-magnetic>
      <svg viewBox="0 0 32 32" aria-hidden="true"><path fill="currentColor" d="M16 3a13 13 0 0 0-11 19.9L3 29l6.3-1.9A13 13 0 1 0 16 3Zm0 2.4a10.6 10.6 0 1 1-5.5 19.7l-.4-.2-3.7 1.1 1.2-3.6-.3-.4A10.6 10.6 0 0 1 16 5.4Zm-4 5.2c-.3 0-.7.1-1 .5-.4.4-1.300 1.300-1.300 3.100s1.400 3.700 1.600 3.900c.2.300 2.700 4.200 6.600 5.700 3.200 1.300 3.900 1 4.600.9.700-.1 2.300-.9 2.600-1.800.3-.9.3-1.700.2-1.800-.1-.2-.4-.3-.8-.5s-2.300-1.100-2.600-1.200c-.4-.1-.6-.2-.9.200-.3.400-1 1.200-1.200 1.500-.2.200-.4.300-.8.100-.4-.2-1.600-.6-3-1.900-1.100-1-1.900-2.200-2.100-2.600-.2-.4 0-.6.200-.8l.6-.7c.2-.2.200-.4.400-.7.100-.3 0-.5 0-.7l-1.200-3c-.3-.8-.6-.7-.9-.7Z"/></svg>
    </a>
    </aside>

    <script src="../scripts/main.ts"></script>
  </body>
</html>

<style is:global>
  .skip { position: fixed; left: -9999px; top: 1rem; z-index: 200; background: var(--ink); color: var(--bg); padding: .7rem 1rem; border-radius: 8px; }
  .skip:focus { left: 1rem; }
  @view-transition { navigation: auto; }
  ::view-transition-old(root) { animation: .35s var(--ease) both vt-out; } ::view-transition-new(root) { animation: .5s var(--ease) both vt-in; }
  @keyframes vt-out { to { opacity: 0; } } @keyframes vt-in { from { opacity: 0; } }
  .dock { position: fixed; left: 0; right: 0; bottom: 0; z-index: 62; display: none; gap: .6rem; padding: .7rem var(--pad) calc(.7rem + env(safe-area-inset-bottom)); background: color-mix(in srgb, var(--bg) 88%, transparent); backdrop-filter: blur(14px); border-top: 1px solid var(--line); }
  .dock .btn { flex: 1; justify-content: center; padding-inline: 1rem; }
  @media (max-width: 799px) { .dock { display: flex; } .wa-fab { display: none !important; } body { padding-bottom: 4.6rem; } }
  .wa-fab { position: fixed; right: clamp(1rem, 2.5vw, 2rem); bottom: clamp(1rem, 2.5vw, 2rem); z-index: 60; width: 58px; height: 58px; border-radius: 50%; display: grid; place-items: center;
    background: var(--ink); color: var(--bg); box-shadow: 0 10px 30px rgba(0, 0, 0, .25); transition: transform .5s var(--ease); }
  .wa-fab svg { width: 30px; height: 30px; }
  .wa-fab::before { content: ''; position: absolute; inset: 0; border-radius: 50%; border: 1px solid var(--accent); animation: ping 2.6s var(--ease) 3; }
  @media (hover: hover) { .wa-fab:hover { transform: scale(1.08) rotate(-6deg); } }
  .wa-fab:active, .dock .btn:active { transform: scale(.95); }
  @media (prefers-reduced-motion: reduce) { .wa-fab::before { animation: none; } }
  @keyframes ping { 0% { transform: scale(1); opacity: .8; } 80%, 100% { transform: scale(1.7); opacity: 0; } }
</style>
